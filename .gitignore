# Local configuration and secrets
.env
.env.local
.env.*.local

# TrackPrompt runtime state (uploads, derived audio, SQLite, model cache)
.trackprompt-data/

# Reviewed model seeds/caches stay local and are provisioned into Docker volumes.
deep-models/
model-checkpoints/

# Setup/repair by-products are never source.
*.bak-*
full-gpu-setup-*.log
repair-*.tmp/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.pytest_*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/.e2e-data/
*.tsbuildinfo

# Generated synthetic fixtures stay local; the generator and README are tracked.
test-fixtures/*
!test-fixtures/README.md

# Blender visualizer smoke outputs are generated locally and may include media.
test-output/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
