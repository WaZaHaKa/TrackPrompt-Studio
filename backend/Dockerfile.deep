FROM python:3.12-slim@sha256:c3d81d25b3154142b0b42eb1e61300024426268edeb5b5a26dd7ddf64d9daf28 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRACKPROMPT_DATA_DIR=/data

RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system trackprompt \
    && useradd --system --gid trackprompt --home-dir /app trackprompt

WORKDIR /app
COPY requirements.txt requirements.lock.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements.lock.txt

COPY app ./app
RUN mkdir -p /data && chown -R trackprompt:trackprompt /app /data

# TrackPrompt Deep dependency (generated by setup-deep-gpu-docker.ps1)
# Do not force a CPU-only Torch wheel; CUDA capability is verified after build.
RUN python -m pip install --no-cache-dir "demucs==4.1.0"

USER trackprompt

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import json,urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=3)); raise SystemExit(0 if data['status'] == 'ok' else 1)"

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
