# Host ports used by compose.yaml.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Optional direct-start paths below assume uvicorn is launched from backend/ as in
# the README. Prefer absolute paths for another working directory. With these
# unset, source runs still default to repository-root .trackprompt-data.
# compose.yaml deliberately overrides both values with its persistent /data volume.
TRACKPROMPT_DATA_DIR=../.trackprompt-data
MODEL_CACHE_DIR=../.trackprompt-data/models

# Optional local Deep adapter. It remains disabled unless all three conditions
# are met: this flag is true, the Demucs package is installed, and every other
# regular file in MODEL_CACHE_DIR/demucs is reviewed, listed in demucs-models.json,
# and matches its SHA-256. Any unmanifested file keeps Deep unavailable.
# TrackPrompt Studio never downloads weights during startup or analysis.
ENABLE_DEMUCS=false
DEMUCS_MODEL_NAME=htdemucs
# auto selects CUDA only when the PyTorch build and container/runtime expose it.
# cpu always stays supported; cuda requests fall back honestly when unavailable.
DEMUCS_DEVICE=auto

# Optional full-feature adapters. Model installation is always explicit; these
# switches never trigger a download during startup or analysis.
GPU_TASK_WORKERS=1
ENABLE_GENRE_TAGGER=false
GENRE_MODEL_ID=laion/clap-htsat-unfused
GENRE_MODEL_REVISION=8fa0f1c6d0433df6e97c127f64b2a1d6c0dcda8a
GENRE_DEVICE=auto
ENABLE_LYRICS_ADAPTER=false
LYRICS_MODEL_NAME=Systran/faster-whisper-small
LYRICS_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
LYRICS_DEVICE=auto
LYRICS_COMPUTE_TYPE=float16
LYRICS_CPU_FALLBACK=false
ENABLE_LOCAL_PROMPT_WRITER=false
LOCAL_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LOCAL_LLM_MODEL_DIGEST=845dbda0ea48
LOCAL_LLM_ENDPOINT=http://prompt-writer:11434
LOCAL_LLM_TIMEOUT_SECONDS=90
LOCAL_LLM_KEEP_LOADED=false
PROMPT_WRITER_DEVICE=cuda

# Upload and lifecycle limits.
MAX_UPLOAD_MB=200
# Production nginx syntax. Keep modest multipart headroom above MAX_UPLOAD_MB.
NGINX_UPLOAD_LIMIT=202m
MAX_DURATION_SECONDS=1200
JOB_TTL_MINUTES=60
ANALYSIS_WORKERS=1
MAX_PENDING_JOBS=2

# Safe subprocess settings. Values must be executable paths, not shell commands.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SUBPROCESS_TIMEOUT_SECONDS=120
# Hard bound for the isolated DSP/optional-Deep worker, after decode and before
# parent-side prompt composition.
ANALYSIS_TIMEOUT_SECONDS=600

# Comma-separated browser origins allowed to call a directly started backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Direct-start Host header base allowlist; CORS origin hostnames are also
# accepted. Compose intentionally fixes both sets to loopback hosts only.
ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver
LOG_LEVEL=INFO

# Frontend development settings. Keep /api when using the Vite proxy.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
