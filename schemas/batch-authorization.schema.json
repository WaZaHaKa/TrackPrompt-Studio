{
  "$id": "https://wzhk.local/schemas/batch-authorization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorizedAt": {
      "type": "string"
    },
    "confirmationDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    },
    "maxSpendUsd": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "planDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "planDigest",
    "maxSpendUsd",
    "authorizedAt",
    "expiresAt",
    "confirmationDigest"
  ],
  "title": "TrackPrompt one-time project budget authorization",
  "type": "object"
}
