{
  "$id": "https://wzhk.local/schemas/continuity-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrackPrompt provider-neutral visual continuity profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "minLength": 1, "type": "string" },
    "masterSeed": { "minimum": 0, "maximum": 4294967295, "type": "integer" },
    "seedLocked": { "type": "boolean" },
    "seedDerivation": { "const": "sha256-v1" },
    "characterProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "minLength": 1, "type": "string" },
          "label": { "minLength": 1, "type": "string" },
          "identity": { "minLength": 1, "type": "string" },
          "wardrobe": { "minLength": 1, "type": "string" },
          "faceHairAge": { "minLength": 1, "type": "string" },
          "referenceAssetIds": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "label", "identity", "wardrobe", "faceHairAge", "referenceAssetIds"]
      }
    },
    "visualAnchors": { "type": "object" },
    "continuityGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "minLength": 1, "type": "string" },
          "label": { "minLength": 1, "type": "string" },
          "lockedTokens": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "required": ["id", "label", "lockedTokens"]
      }
    }
  },
  "required": ["schemaVersion", "projectId", "masterSeed", "seedLocked", "seedDerivation", "characterProfiles", "visualAnchors", "continuityGroups"]
}
