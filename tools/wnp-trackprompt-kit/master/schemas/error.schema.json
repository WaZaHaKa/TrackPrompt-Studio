{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wzhk:wnp:1:error",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "wnp/1"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "protocol",
    "error"
  ],
  "additionalProperties": true
}
