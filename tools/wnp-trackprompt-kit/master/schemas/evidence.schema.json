{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wzhk:wnp:1:evidence",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^evidence/[A-Za-z0-9_./-]+$",
      "maxLength": 512
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "media_type": {
      "type": "string",
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    }
  },
  "required": [
    "path",
    "sha256"
  ],
  "additionalProperties": true
}
