{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wzhk:wnp:1:node",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "wnp/1"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "node": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "stream": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "protocol",
    "node",
    "project",
    "stream",
    "agent"
  ],
  "additionalProperties": true
}
