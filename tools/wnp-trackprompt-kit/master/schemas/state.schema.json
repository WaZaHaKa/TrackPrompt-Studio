{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wzhk:wnp:1:state",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "wnp/1"
    },
    "stream": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "idle",
        "queued",
        "running",
        "waiting",
        "paused",
        "complete",
        "failed",
        "degraded",
        "unknown"
      ]
    },
    "health": {
      "enum": [
        "ok",
        "degraded",
        "error",
        "unknown"
      ]
    },
    "run": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "task": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2048
    },
    "progress": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "current": {
              "type": "number",
              "minimum": 0
            },
            "total": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
            }
          },
          "required": [
            "current",
            "unit"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object"
    },
    "observations": {
      "type": "object"
    }
  },
  "required": [
    "protocol",
    "stream",
    "sequence",
    "timestamp",
    "state",
    "health"
  ],
  "additionalProperties": true
}
