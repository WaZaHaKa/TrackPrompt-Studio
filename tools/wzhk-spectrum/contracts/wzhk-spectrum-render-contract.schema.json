{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wzhkmedia.local/schemas/wzhk-spectrum-render-contract-1.0.0.json",
  "title": "WZHK Spectrum render contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rendererId",
    "project",
    "track",
    "sections",
    "branding",
    "renderer"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "rendererId": {
      "const": "wzhk-spectrum"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "artist",
        "title"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bpm",
        "timeSignature",
        "totalBars",
        "gridDurationSeconds",
        "audioAssetDirectory",
        "preferredMasterExtensions"
      ],
      "properties": {
        "bpm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timeSignature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1
            },
            "denominator": {
              "type": "integer",
              "enum": [
                1,
                2,
                4,
                8,
                16,
                32
              ]
            }
          }
        },
        "totalBars": {
          "type": "integer",
          "minimum": 1
        },
        "gridDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "audioAssetDirectory": {
          "type": "string",
          "minLength": 1
        },
        "preferredMasterExtensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "startBarInclusive",
          "endBarExclusive",
          "startSeconds",
          "endSeconds",
          "visualCue"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "startBarInclusive": {
            "type": "integer",
            "minimum": 1
          },
          "endBarExclusive": {
            "type": "integer",
            "minimum": 2
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "visualCue": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "logoAssetDirectory",
        "removeMonstercatIdentityFromGeneratedWorkspace"
      ],
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "logoAssetDirectory": {
          "type": "string",
          "minLength": 1
        },
        "removeMonstercatIdentityFromGeneratedWorkspace": {
          "type": "boolean"
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "engine",
        "vendorSourceDirectory",
        "workspaceRoot",
        "capture",
        "audioPolicy"
      ],
      "properties": {
        "platform": {
          "const": "windows"
        },
        "engine": {
          "const": "rainmeter-audio-spectrum"
        },
        "vendorSourceDirectory": {
          "type": "string",
          "minLength": 1
        },
        "workspaceRoot": {
          "type": "string",
          "minLength": 1
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "fps"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "fps": {
              "type": "integer",
              "enum": [
                24,
                25,
                30,
                50,
                60
              ]
            }
          }
        },
        "audioPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visualizeSystemOutput",
            "replaceCapturedAudioWithOriginalMaster"
          ],
          "properties": {
            "visualizeSystemOutput": {
              "type": "boolean"
            },
            "replaceCapturedAudioWithOriginalMaster": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
