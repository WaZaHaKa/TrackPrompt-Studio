    "aspectRatio": "16:9",
    "durationPolicy": "exactly match original audio",
    "videoCodecPrimary": "H.264 High Profile, yuv420p, CRF 16 or validated equivalent",
    "audioPrimary": "original track muxed as AAC 320 kb/s; preserve a PCM or FLAC master separately",
    "optionalIntermediate": "ProRes 422 LT or FFV1 when disk space permits"
  },
  "assemblyPrinciples": [
    "Each of the 16 base scenes starts from one approved keyframe.",
    "Use one 81-frame I2V clip per base scene, plus at most one alternate for the four hero scenes.",
    "Fill longer scene durations with 2.5D keyframe parallax, restrained optical-flow slowdown, end-frame drift, and transition overlap.",
    "Never loop a whole clip visibly and never hide instability with frantic editing.",
    "Preserve screen direction and the amber-thread motif across scene boundaries.",
    "The first 15 seconds contain immediate story action and no title card."
  ],
