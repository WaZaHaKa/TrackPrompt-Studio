{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wzhkmedia.local/schemas/trackprompt-local-shot-bank-1.0.0.json",
  "title": "TrackPrompt Local Shot Bank",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "shotCount",
    "shots"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "shotCount": {
      "const": 16
    },
    "shots": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "shotId",
          "order",
          "title",
          "narrativeIntent",
          "keyframePrompt",
          "prompt",
          "negativePrompt",
          "seed",
          "provisionalStartSeconds",
          "provisionalEndSeconds"
        ],
        "properties": {
          "shotId": {
            "type": "string",
            "pattern": "^shot-[0-9]{3}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "keyframePrompt": {
            "type": "string",
            "minLength": 30
          },
          "prompt": {
            "type": "string",
            "minLength": 20
          },
          "negativePrompt": {
            "type": "string",
            "minLength": 20
          },
          "seed": {
            "type": "integer"
          },
          "provisionalStartSeconds": {
            "type": "number",
            "minimum": 0
          },
          "provisionalEndSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
